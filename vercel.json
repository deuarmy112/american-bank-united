{
  "outputDirectory": ".",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/abu-logo.png"
    },
    {
      "source": "/api/accounts/lookup",
      "destination": "/api/[...path]?path=accounts/lookup"
    },
    {
      "source": "/api/transactions/transfer",
      "destination": "/api/[...path]?path=transactions/transfer"
    },
    {
      "source": "/api/cards/requests",
      "destination": "/api/[...path]?path=cards/requests"
    },
    {
      "source": "/api/cards/:id/status",
      "destination": "/api/[...path]?path=cards/:id/status"
    },
    {
      "source": "/api/chat/start",
      "destination": "/api/[...path]?path=chat/start"
    },
    {
      "source": "/api/chat/read",
      "destination": "/api/[...path]?path=chat/read"
    },
    {
      "source": "/api/chat",
      "destination": "/api/[...path]?path=chat"
    },
    {
      "source": "/api/admin/chat/:conversationId",
      "destination": "/api/[...path]?path=admin/chat/:conversationId"
    },
    {
      "source": "/api/admin/chat",
      "destination": "/api/[...path]?path=admin/chat"
    },
    {
      "source": "/api/admin/transactions/:transactionId/:action",
      "destination": "/api/[...path]?path=admin/transactions/:transactionId/:action"
    },
    {
      "source": "/api/admin/transactions/:action",
      "destination": "/api/[...path]?path=admin/transactions/:action"
    },
    {
      "source": "/api/admin/settings/:setting",
      "destination": "/api/[...path]?path=admin/settings/:setting"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
